APP_NAME="Profile Refresher"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose service names (see compose.yaml).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=profiles
DB_USERNAME=app
DB_PASSWORD=app

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

SCOUT_DRIVER=database

# OnlyFans, signed api2 requests (the default "onlyfans" account; no key or login needed).
ONLYFANS_BASE_URL=https://onlyfans.com
# Signing rules: comma-separated sources, tried in order. "webapp:<page URL>" reads them from
# OnlyFans' own web app code; a local JSON file pins rules by hand; a URL reads a public rule feed.
# Empty = OnlyFans' web app only. With a feed as fallback, e.g.:
# ONLYFANS_RULES_SOURCES=webapp:https://onlyfans.com/,https://raw.githubusercontent.com/rafa-9/dynamic-rules/main/rules.json
ONLYFANS_RULES_SOURCES=
ONLYFANS_RULES_TTL_MINUTES=60
ONLYFANS_SESSION_TTL_HOURS=24

# Fans API (https://docs.onlyfansapi.com), the "fansapi" account, for comparison only.
# Put your key in .env only, never commit it.
FANSAPI_BASE_URL=https://app.onlyfansapi.com
FANSAPI_KEY=
# true = ?fresh=true on every request (1 credit each); false = Fans API cache when available (0 credits).
FANSAPI_FRESH=false

# v2 = fixed handler; legacy = the handler from the incident (for reproduction only).
REFRESH_HANDLER=v2

# Queue tuning (see README, "Timeouts"). retry_after must stay above the job timeout (30 s).
REDIS_QUEUE_RETRY_AFTER=90
HORIZON_REFRESH_PROCESSES=4
REFRESH_ACCOUNT_CONCURRENCY=2

# Public demo behind a reverse proxy (config/demo.php): proxied requests can only read.
PUBLIC_READ_ONLY=false
PUBLIC_URL=

# The local fake upstream used by workload:run and workload:crash.
FAKE_UPSTREAM_URL=http://fake-upstream:8080
